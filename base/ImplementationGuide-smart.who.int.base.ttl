       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/CodeSystem/CoreDataElementType> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/CoreDataElementType" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Core Data Element Type" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "CodeSystem for Core Data Element types - defines the type of FHIR resource that a Core Data Element references." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [

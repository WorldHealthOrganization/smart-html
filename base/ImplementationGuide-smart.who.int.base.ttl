       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISCO-08 Value Set" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Extensible value set of ISCO-08 codes for persona classification" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 89 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/ActorDefinition/DAK.Persona.System.LIS> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/DAK.Persona.System.LIS" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Laboratory Information System (LIS)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A digital system that manages the complete lifecycle of laboratory test orders,\nspecimen tracking, result production, and result reporting to healthcare providers\nand persons.\n\nThe LIS supports DHIs including:\n- Transmit and track diagnostic orders (2.10.2)\n- Capture diagnostic results from digital devices (2.10.3)\n- Transmit person's diagnostic result to healthcare provider (2.10.1)\n- Transmit diagnostics result or availability of result to person(s) (1.1.4)\n- Track biological specimens (2.10.4)\n\n**Services and Application Type**: A6 — Laboratory information systems\n\n**Functional areas**: Lab requests/test ordering, sample tracking, sample\nprocessing, results reporting." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 90 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/StructureDefinition/LinkIdExt> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/LinkIdExt" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "LinkIdExt" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Smart Guidelines link identifier extension" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 91 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/ActorDefinition/DAK.Persona.System.LMIS> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/DAK.Persona.System.LMIS" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Logistics Management Information System (LMIS)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A digital system that manages the health supply chain from quantification\nand forecasting through distribution, inventory management, and consumption tracking.\n\nThe LMIS supports DHIs including:\n- Manage inventory and distribution of health commodities (3.2.1)\n- Notify stock levels of health commodities (3.2.2)\n- Monitor cold-chain sensitive commodities (3.2.3)\n- Register licensed drugs and health commodities (3.2.4)\n- Manage procurement of commodities (3.2.5)\n\n**Services and Application Type**: B6 — Logistics management information systems (LMIS)" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 92 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ConceptMap" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/ConceptMap/CDHIv1toCDHIv2> ;
         fhir:Reference.reference [ fhir:value "ConceptMap/CDHIv1toCDHIv2" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Mapping from CDHI v1 to CDISAH v2" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Mapping from the Classification of Digital Health Interventions v1 (CDHI v1, 2018)\nto the Classification of Digital Interventions, Services and Applications in Health v2\n(CDISAH v2, 2023).\n\nKey structural changes reflected in this map:\n- User group labels updated throughout (e.g. 'Clients' → 'Persons',\n  'Health workers' → 'Healthcare providers', 'Health system managers' →\n  'Health management and support personnel').\n- Civil Registration and Vital Statistics (CRVS) consolidated: six v1 codes\n  (3.4.1–3.4.6) merged into two v2 codes (3.4.1, 3.4.2).\n- Health financing section restructured: v1 3.5.1 (insurance membership) and\n  3.5.2 (billing) updated; v1 3.5.3–3.5.6 shifted by one (now 3.5.4–3.5.6 + new 3.5.3).\n- Data services (group 4) substantially revised: 4.1.1 changed scope,\n  4.3 expanded from 4 to 5 codes, 4.4 split from 1 to 3 codes, 4.5 is entirely new.\n- New v2 categories with no v1 equivalent are listed as 'unmatched' targets." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 93 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ConceptMap" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/ConceptMap/CDSCv1toCDSCv2> ;
         fhir:Reference.reference [ fhir:value "ConceptMap/CDSCv1toCDSCv2" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Mapping from CDSC v1 to Services and Application Types v2" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Mapping from the Classification of Digital Health System Categories v1 (CDSCv1, 2018)\nto the Classification of Digital Health Services and Application Types v2 (CDSCv2, 2023).\n\nThe v1 used 25 single-letter codes (A–Y). The v2 completely restructured this into\n5 representations within the digital health enterprise architecture, each with\nalphanumeric codes (A1–A9, B1–B8, C1–C11, D1–D8, E1–E2).\n\nSeveral new v2 categories have no v1 equivalent:\nA3 (Decision support), A4 (Diagnostics), B1 (Blood bank), B3 (Health program monitoring),\nB7 (Patient administration), C4 (Facility registries), C5 (Health worker registry),\nC7 (Immunisation information), C8 (Master patient index), C9 (Product catalogues),\nC10 (Public Key directories), D1 (Analytics), D3 (Data warehouses)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 94 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/StructureDefinition/Markdown> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/Markdown" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Markdown" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Markdown extension" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 95 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;

       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Logical Model for representing User Scenarios from a DAK. Narratives that describe how the different personas may interact with each other." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]

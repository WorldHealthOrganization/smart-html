     fhir:ImplementationGuide.definition.grouping [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "Conformance" ] ;
       fhir:ImplementationGuide.definition.grouping.name [ fhir:value "Conformance" ] ;
       fhir:ImplementationGuide.definition.grouping.description [ fhir:value "constraints and profile structures for SMART Guidelines resources" ]
     ] ;
     fhir:ImplementationGuide.definition.resource [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ActorDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/ActorDefinition/SGAuthoring.Persona.BusinessAnalyst> ;
         fhir:Reference.reference [ fhir:value "ActorDefinition/SGAuthoring.Persona.BusinessAnalyst" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Business Analyst" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A digital health informatician specializing in business analysis who authors\nL2 DAK components. Business analysts translate clinical guidelines and\nnormative products into structured DAK artifacts including business processes,\ndata dictionaries, decision-support logic, and requirements.\n\nKey activities:\n- Review L1 source documents and extract structured content\n- Author generic personas based on task-shifting guidelines\n- Create user scenario narratives\n- Design BPMN 2.0 business process diagrams\n- Define core data elements and data dictionary\n- Develop decision-support logic tables (DMN standard)\n- Develop scheduling logic tables\n- Define indicators and performance metrics\n- Capture functional and non-functional requirements\n- Streamline content across DAK components for consistency\n\n**Source**: IG Starter Kit, L2 DAK Authoring, Section 2.1 \"Fill in DAK components\";\nCommunity of Practice page" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 1 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:logical" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/StructureDefinition/BusinessProcessWorkflow> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/BusinessProcessWorkflow" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Business Process Workflow (DAK)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Logical Model for representing Generic Business Processes and Workflows from a DAK. A business process is a set of related activities or tasks performed together to achieve the objectives of the health programme area." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 2 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:logical" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/base/StructureDefinition/BusinessProcessWorkflowSource> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/BusinessProcessWorkflowSource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Business Process Workflow Source" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Source reference for Business Process Workflow - exactly one of the following must be provided:\n- url (url data type): URL to retrieve BusinessProcessWorkflow definition from input/ or external source\n- canonical (canonical data type): Canonical URI pointing to the BusinessProcessWorkflow definition\n- instance: Inline BusinessProcessWorkflow instance data" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 3 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]

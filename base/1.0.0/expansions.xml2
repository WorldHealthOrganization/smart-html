                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;http://smart.who.int/base/CodeSystem/CDSCv2&quot;, &quot;version&quot;: &quot;1.0.0&quot;, &quot;code&quot;: &quot;D3&quot;, &quot;display&quot;: &quot;Data warehouses&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="&lt;coding&gt;&lt;system value=&quot;http://smart.who.int/base/CodeSystem/CDSCv2&quot;&gt;&lt;version value=&quot;1.0.0&quot;&gt;&lt;code value=&quot;D3&quot;&gt;&lt;display value=&quot;Data warehouses&quot;&gt;&lt;/coding&gt;" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
              </tr>
              <tr>
                <td>
                  <a name="x-http://smart.who.int/base/CodeSystem/CDSCv2-D4"> </a>
                  <code>http://smart.who.int/base/CodeSystem/CDSCv2</code>
                </td>
                <td style="white-space:nowrap">  
                  <a href="CodeSystem-CDSCv2.html#CDSCv2-D4">D4</a>
                </td>
                <td>Environmental monitoring systems</td>
                <td>Systems that monitor environmental determinants of health such as air quality, water safety and vector habitats.</td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;http://smart.who.int/base/CodeSystem/CDSCv2&quot;, &quot;version&quot;: &quot;1.0.0&quot;, &quot;code&quot;: &quot;D4&quot;, &quot;display&quot;: &quot;Environmental monitoring systems&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>

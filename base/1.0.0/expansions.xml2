            <p>This value set contains 10 concepts</p>
            <table class="codes" data-fhir="generated">
              <tr>
                <td>
                  <b>System</b>
                </td>
                <td style="white-space:nowrap">
                  <b>Code</b>
                </td>
                <td>
                  <b>Display (en)</b>
                </td>
                <td>

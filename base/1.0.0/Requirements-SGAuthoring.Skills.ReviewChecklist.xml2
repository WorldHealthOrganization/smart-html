    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement">
      <valueMarkdown value="Can verify global checklist items: maturity level, versioning policy, HL7 publishing requirements, QA report, and changes page."/>

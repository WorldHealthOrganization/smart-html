        <system value="url"/>
        <value value="http://who.int"/>
      </telecom>
    </valueContactDetail>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.description">
    <valueMarkdown value="Capability to manage versioning, publication-request.json, release tags, and publication workflow."/>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.jurisdiction"/>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.actor">
    <valueCanonical value="http://smart.who.int/base/ActorDefinition/SGAuthoring.Persona.PublicationManager"/>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement">
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key">
      <valueId value="REL-01"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label">
      <valueString value="Determine version number"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance">
      <valueCode value="SHALL"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement">
      <valueMarkdown value="Can review changes since last release, determine if changes are breaking, and update version number following semantic versioning."/>
    </extension>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement">
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key">
      <valueId value="REL-02"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label">
      <valueString value="Update IG status for release"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance">
      <valueCode value="SHALL"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement">
      <valueMarkdown value="Can update IG and all conformance artifacts: status to active, version without label, releaseLabel to release, and date to current date."/>
    </extension>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement">
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key">
      <valueId value="REL-03"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label">
      <valueString value="Create publication-request.json"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance">
      <valueCode value="SHALL"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement">
      <valueMarkdown value="Can create a correct publication-request.json with matching package-id, version, path, ci-build, and first/subsequent flags."/>
    </extension>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement">
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key">
      <valueId value="REL-04"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label">
      <valueString value="Create release tag"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance">
      <valueCode value="SHALL"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement">
      <valueMarkdown value="Can create a GitHub release and tag in the form vX.Y.Z to trigger the automated publication workflow."/>
    </extension>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement">
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key">
      <valueId value="REL-05"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label">
      <valueString value="Verify publication"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance">
      <valueCode value="SHALL"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement">
      <valueMarkdown value="Can verify the publication workflow succeeded and the IG is available at the sitepreview URL."/>
    </extension>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement">
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key">
      <valueId value="REL-06"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label">
      <valueString value="Reset to draft"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance">
      <valueCode value="SHALL"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement">
      <valueMarkdown value="Can reset the main branch to draft status with updated version number after publication."/>
    </extension>
  </extension>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement">
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key">
      <valueId value="REL-07"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label">
      <valueString value="Maintain change log"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance">
      <valueCode value="SHALL"/>
    </extension>
    <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement">
      <valueMarkdown value="Can maintain a changes page with release summary, known issues, and categorized changes (non-compatible, compatible substantive, non-substantive)."/>
    </extension>
  </extension>
